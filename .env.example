# US-K1 · DEBUG defaults to OFF in settings.py. Local work opts in here; a deployment
# leaves it unset and must then supply DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS, or
# settings refuses to import (deliberately — a silent insecure default is worse).
DJANGO_DEBUG=1

# Required when DEBUG is off. Generate with:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
DJANGO_SECRET_KEY=

# Required when DEBUG is off. Comma-separated hostnames; '*' is refused.
DJANGO_ALLOWED_HOSTS=

# §12.4 CORS allowlist — comma-separated ORIGINS (scheme + host), empty by default.
# The mobile app is a native client and needs nothing here; only a browser surface does.
DJANGO_CORS_ORIGINS=
DATABASE_URL=postgres://localhost/kupkop_dev
TEST_DATABASE_NAME=kupkop_test

# FCM push (US-P2) — leave blank for dev no-op; set both in production.
# FCM_PROJECT_ID is the Firebase project ID (e.g. kupkop-prod).
# FCM_CREDENTIALS_PATH is the filesystem path to the service-account JSON key
# downloaded from the Firebase console → Project settings → Service accounts.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

# S3 media storage (US-D2) — leave blank for dev stub (presigned URLs are placeholders).
# Provision two buckets in ap-southeast-1: one public (pet/listing/report photos) and one
# restricted (verification documents — no public read; reached only via signed_get_url).
# Apply backend/deploy/s3-lifecycle.json to the restricted bucket after creating it.
MEDIA_S3_BUCKET_PUBLIC=
MEDIA_S3_BUCKET_RESTRICTED=

# US-E2 · §16.5 error reporting. Unset = no-op (the FCM/S3 seam posture); nothing is sent and
# nothing errors. SENTRY_RELEASE is what makes an OTA bundle distinguishable from the native
# build it ran on — without it, a crash from an over-the-air fix looks identical to one in the
# binary underneath, which defeats §16.4's whole OTA strategy at the moment you need it.
# Requires `pip install sentry-sdk` at deploy time; the seam degrades to a no-op without it.
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
